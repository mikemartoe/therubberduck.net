    {
      "t": 31.74,
      "end": 33.6,
      "text": "There are no deals."
    },
    {
      "t": 33.6,
      "end": 40.72,
      "text": "Why does it take the information going public before justice is served?"
    },
    {
      "t": 40.72,
      "end": 47.24,
      "text": "Foreign agents within our government at the highest levels."
    },
    {
      "t": 47.24,
      "end": 52.48,
      "text": "No private communications, past, present and future."
    },
    {
      "t": 52.48,
      "end": 59.06,
      "text": "No communications made outside of this platform."
    },
    {
      "t": 59.06,
      "end": 67.16,
      "text": "Any claims that contradict the above should be considered FAKE NEWS and disregarded immediately."
    },
    {
      "t": 67.16,
      "end": 74.48,
      "text": "Where we go one, we go all."
    },
    {
